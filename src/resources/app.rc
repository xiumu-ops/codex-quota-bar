#include <windows.h>
#include "resource.h"

#pragma code_page(65001)

IDI_APP_ICON ICON "assets/icons/app-icon.ico"

IDD_TRANSPARENCY_DIALOG DIALOGEX 0, 0, 210, 84
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "透明背景"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    LTEXT           "请输入透明度（0–90）：", -1, 12, 13, 116, 12
    EDITTEXT        IDC_TRANSPARENCY_EDIT, 132, 11, 62, 14, ES_CENTER | ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "0 = 不透明，90 = 最大透明度", -1, 12, 34, 182, 12
    DEFPUSHBUTTON   "确定", IDOK, 88, 59, 50, 15
    PUSHBUTTON      "取消", IDCANCEL, 144, 59, 50, 15
END

// 嵌入应用清单（Windows 11、PerMonitorV2 DPI 感知）
1 24 "src/resources/app.manifest"

1 VERSIONINFO
 FILEVERSION 2,5,3,0
 PRODUCTVERSION 2,5,3,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "xiumu-ops\0"
            VALUE "FileDescription", "Codex-Quota-Bar\0"
            VALUE "FileVersion", "2.5.3\0"
            VALUE "InternalName", "Codex-Quota-Bar\0"
            VALUE "OriginalFilename", "Codex-Quota-Bar.exe\0"
            VALUE "ProductName", "Codex-Quota-Bar\0"
            VALUE "ProductVersion", "2.5.3\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
